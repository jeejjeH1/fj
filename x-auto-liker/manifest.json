{
  "manifest_version": 3,
  "name": "X Auto Liker",
  "version": "7.0.2",
  "description": "جعبه‌ابزار فارسی X: لایک نوبتی، کامنت هوشمند، فونت فارسی، دانلود، عکس از توییت، پوشه‌بندی، قالب متن، آمار و مدیریت دنبال‌شوندگان.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.com/*",
    "https://api.twitter.com/*",
    "https://mobile.twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://abs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "content/media-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "content/common.js",
        "content/persian.js",
        "content/tweet-tools.js",
        "content/card.js",
        "content/composer.js",
        "content/analytics-collect.js",
        "content/sync.js",
        "content/comments.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ]
    }
  ],
  "commands": {
    "next-link": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "حالت دستی: رفتن به لینک بعدی"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Auto Liker"
  }
}
